// ─────────────────────────────────────────────────────────────────────────
//  Rival Auto Parts — B2B wholesale portal
//  Prisma schema (PostgreSQL)
// ─────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────

enum Role {
  ADMIN // полный доступ
  RA // как админ, без «Настроек», видит всех клиентов
  MANAGER // видит только своих клиентов
  ACCOUNTANT // бухгалтер: видит всех клиентов, ограниченный набор вкладок
  CLIENT
}

enum OrderStatus {
  NEW // заказ принят
  SENT // отправлен менеджеру (WhatsApp)
  PROCESSING // в работе
  OUT_OF_STOCK // нет в наличии
  ISSUED // выдано
  COMPLETED // выполнен
  CANCELLED // отказ клиента
}

enum ReturnStatus {
  NEW
  PROCESSING
  ACCEPTED
  REJECTED
}

enum ProductBadge {
  NEW // новинка
  HIT // хит продаж
}

enum DiscountTarget {
  ALL // на все товары
  PRODUCT // на конкретные товары
  CATEGORY // на категорию
  BRAND // на марку/бренд
}

// ─── Users (admins, managers, clients) ───────────────────────────────────

model User {
  id           String  @id @default(cuid())
  role         Role    @default(CLIENT)
  login        String  @unique // used to sign in
  passwordHash String
  fullName     String // ФИО / название организации
  email        String? @unique
  phone        String? // for managers this is the WhatsApp number
  address      String?
  city         String? // населённый пункт
  balance      Decimal @default(0) @db.Decimal(12, 2) // баланс (долг отражается отрицательным)
  discountPercent Int  @default(0) // персональная скидка клиента, %
  comment      String?
  isActive     Boolean @default(true)
  debtSince    DateTime? // с какого момента баланс ушёл в минус (для автоблокировки)

  // Manager ↔ Client self-relation: a CLIENT references its MANAGER
  managerId String?
  manager   User?   @relation("ManagerClients", fields: [managerId], references: [id], onDelete: SetNull)
  clients   User[]  @relation("ManagerClients")

  warehouseAccess ClientWarehouseAccess[]
  orders          Order[]
  searchLogs      SearchLog[]
  favorites       Favorite[]
  cartItems       SavedCartItem[]
  returns             Return[]
  productViews        ProductView[]
  broadcastRecipients BroadcastRecipient[]
  discountRules       DiscountRule[]      @relation("UserDiscountRules")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([managerId])
  @@index([role])
}

// ─── Catalog ─────────────────────────────────────────────────────────────

model Product {
  id       String  @id @default(cuid())
  code     String  @unique // внутренний код 1С (stable upsert key)
  sku      String // артикул
  name     String
  fullName String? // применяемость
  brand    String?
  category String?
  price    Decimal  @default(0) @db.Decimal(12, 2) // базовая цена
  oldPrice Decimal? @db.Decimal(12, 2) // цена до последнего изменения (скидка от снижения)
  priceDropAt DateTime? // когда зафиксировано снижение цены (скидка живёт N дней)
  newUntil    DateTime? // авто-значок «новинка» до этой даты (ставится при появлении в 1С)
  isFinalPrice Boolean @default(false) // 1С is_final_price: цена финальная, скидки клиента не применяются
  imageUrl String?

  model        String? // модель авто (выводится из применяемости)
  modelNorm    String? // нормализованная модель (для дедупликации/поиска)
  pinned       Boolean       @default(false) // закреплённая карточка (показывается первой)
  pinnedAt     DateTime?
  badge        ProductBadge?
  skuNorm      String? // нормализованный артикул (умный поиск)
  fullNameNorm String? // нормализованная применяемость (умный поиск)

  stocks      Stock[]
  orderItems  OrderItem[]
  favorites   Favorite[]
  cartItems   SavedCartItem[]
  views       ProductView[]
  returnItems Return[]
  broadcasts  BroadcastProduct[]
  discountRules DiscountRuleProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sku])
  @@index([brand])
  @@index([category])
  @@index([pinned])
  @@index([skuNorm])
  @@index([fullNameNorm])
  @@index([brand, model])
  // Trigram GIN indexes: the catalog search is built on `contains` (LIKE %q%),
  // which B-tree indexes can't serve. Requires the pg_trgm extension (created
  // in the same migration).
  @@index([sku(ops: raw("gin_trgm_ops"))], map: "Product_sku_trgm", type: Gin)
  @@index([name(ops: raw("gin_trgm_ops"))], map: "Product_name_trgm", type: Gin)
  @@index([fullName(ops: raw("gin_trgm_ops"))], map: "Product_fullName_trgm", type: Gin)
  @@index([skuNorm(ops: raw("gin_trgm_ops"))], map: "Product_skuNorm_trgm", type: Gin)
  @@index([fullNameNorm(ops: raw("gin_trgm_ops"))], map: "Product_fullNameNorm_trgm", type: Gin)
}

model Warehouse {
  id   String @id @default(cuid())
  name String @unique // "БК склад", "Car City склад", ...

  stocks       Stock[]
  clientAccess ClientWarehouseAccess[]

  createdAt DateTime @default(now())
}

// Per-warehouse stock for a product
model Stock {
  id          String @id @default(cuid())
  productId   String
  warehouseId String
  qty         Int    @default(0)

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@unique([productId, warehouseId])
  @@index([warehouseId])
}

// Which warehouses a given client is allowed to see stock for
model ClientWarehouseAccess {
  id          String @id @default(cuid())
  userId      String
  warehouseId String

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, warehouseId])
  @@index([warehouseId])
}

// ─── Orders ──────────────────────────────────────────────────────────────

model Order {
  id      String      @id @default(cuid())
  userId  String
  status  OrderStatus @default(NEW)
  comment String?
  total   Decimal     @default(0) @db.Decimal(12, 2)
  paid    Decimal     @default(0) @db.Decimal(12, 2) // оплачено; долг = total − paid
  debtApplied Boolean @default(false) // долг уже зачислен в баланс клиента
  onecSent   Boolean @default(false) // выгружен в 1С
  onecNumber String? // номер документа в 1С

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String?
  sku       String // snapshot at order time
  name      String // snapshot at order time
  price     Decimal @db.Decimal(12, 2) // snapshot at order time
  qty       Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

// ─── Shadow logging of search queries ────────────────────────────────────

model SearchLog {
  id           String  @id @default(cuid())
  query        String
  resultsCount Int     @default(0)
  userId       String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ─── Returns (возвраты — НЕ выгружаются в 1С) ────────────────────────────

model Return {
  id            Int          @id @default(autoincrement()) // номер возврата
  userId        String?
  productId     String?
  code          String? // код 1С товара
  sku           String // артикул
  name          String
  brand         String?
  qty           Int          @default(1)
  price         Decimal      @db.Decimal(12, 2)
  warehouseName String? // со склада
  reason        String? // причина возврата
  comment       String?
  status        ReturnStatus @default(NEW)
  createdAt     DateTime     @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}

// ─── Favorites & saved carts (для видимости в админке) ───────────────────

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
}

model SavedCartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  qty       Int      @default(1)
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([productId])
}

// ─── Product views (статистика просмотров карточек) ──────────────────────

model ProductView {
  id        String   @id @default(cuid())
  productId String
  userId    String?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([userId])
  @@index([createdAt])
}

// ─── Analogs (импорт из .xlsx, поиск по аналогам) ────────────────────────
//  code  — то, что вбивают в поиск (иногда это артикул товара)
//  brand — бренд аналога
//  sku   — артикул товара в каталоге, который надо показать
model Analog {
  id    String  @id @default(cuid())
  code  String
  brand String?
  sku   String

  @@index([code])
  @@index([sku])
}

// ─── Settings (key/value: глобальная скидка, текст блокировки, интервал) ──
model Setting {
  key   String @id
  value String
}

// ─── Broadcasts (рассылки клиентам) ──────────────────────────────────────
model Broadcast {
  id        String   @id @default(cuid())
  title     String?
  text      String
  isGlobal  Boolean  @default(false) // true → всем клиентам; false → только recipients
  createdAt DateTime @default(now())

  products   BroadcastProduct[]
  recipients BroadcastRecipient[]
}

model BroadcastProduct {
  id          String @id @default(cuid())
  broadcastId String
  productId   String

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([broadcastId])
  @@index([productId])
}

model BroadcastRecipient {
  id          String    @id @default(cuid())
  broadcastId String
  userId      String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, userId])
  @@index([userId])
}

// ─── Discount rules (адресные скидки) ────────────────────────────────────
//  userId = null → скидка всем клиентам; иначе — конкретному клиенту.
//  target: ALL (весь каталог) / PRODUCT (товары в DiscountRuleProduct) /
//  CATEGORY (поле category) / BRAND (поле brand).
//  При расчёте берётся НАИБОЛЬШИЙ подходящий процент; снижение цены при
//  синхронизации с 1С прибавляется сверху (см. lib/pricing.ts).
model DiscountRule {
  id        String         @id @default(cuid())
  name      String? // метка для админа
  percent   Int // 1..95
  userId    String? // null = всем клиентам
  target    DiscountTarget @default(ALL)
  category  String? // когда target=CATEGORY
  brand     String? // когда target=BRAND
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user     User?                 @relation("UserDiscountRules", fields: [userId], references: [id], onDelete: Cascade)
  products DiscountRuleProduct[]

  @@index([userId])
  @@index([target])
  @@index([active])
}

model DiscountRuleProduct {
  id        String @id @default(cuid())
  ruleId    String
  productId String

  rule    DiscountRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([ruleId, productId])
  @@index([productId])
}
