# ────────────────────────────────────────────────────────────────
#  Скопируйте этот файл в .env  (Copy this file to .env) и при
#  необходимости поправьте пароль БД под свою установку PostgreSQL.
# ────────────────────────────────────────────────────────────────

# Локальная база PostgreSQL. Если у вас пароль пользователя postgres
# отличается от "postgres" — впишите свой.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rival_auto_parts?schema=public"

# Секрет для подписи сессий (для локального показа можно оставить как есть).
AUTH_SECRET="rival_local_dev_secret_change_me_0123456789abcdef0123456789abcdef"

# 1С HTTP-сервис (товары + приём заказов). Менять не нужно.
ONEC_API_URL="http://109.233.111.250:8888/hs/v1/products"
ONEC_ORDERS_URL="http://109.233.111.250:8888/hs/v1/orders"
ONEC_API_USER=""
ONEC_API_PASSWORD=""

# Токен для ручной синхронизации (POST /api/sync с заголовком X-Sync-Token).
SYNC_SECRET="rival_sync_2026"

# Авто-синхронизация с 1С. Для локального показа выключена (данные уже
# загружены из db-seed.sql). Поставьте "true", если хотите тянуть свежие
# данные из 1С прямо во время работы.
SYNC_ENABLED="false"
SYNC_CRON="*/30 * * * *"
